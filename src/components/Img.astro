---
import { srcsetFor, dimensionsOf } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  class?: string;
  priority?: boolean;
  position?: string;
}

const { src, alt, sizes = '100vw', class: className, priority = false, position } = Astro.props;
const srcset = srcsetFor(src);
const dims = dimensionsOf(src);
---
<img
  class={className}
  src={src}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={alt}
  width={dims?.width}
  height={dims?.height}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : undefined}
  style={position ? `object-position:${position}` : undefined}
/>
