---
/**
 * 3. Experiences, with who leads them: a day at the camp from first light to the fire.
 * On large screens the photograph holds still while the day scrolls past, the sun travels
 * its arc and the ground turns to night for the fire. On phones, one moment per card.
 */
import { getEntry, getCollection } from 'astro:content';
import Img from '../Img.astro';
import Stamp from '../Stamp.astro';
import Icon from '../Icon.astro';
import PickButton from '../PickButton.astro';
import { FAMILY_NAMES, type StampId } from '../../lib/stamps';
import { direction } from '../../lib/data';

const d = (await getEntry('home', 'home'))!.data.day;
const all = await getCollection('experiences');
const moments = d.moments.map((m) => {
  const e = all.find((x) => x.id === m.experience);
  if (!e) throw new Error(`Home day: unknown experience "${m.experience}"`);
  return { ...m, e };
});
const last = moments.length - 1;
---
<section class="day section" id="day" aria-labelledby="day-title" data-day>
  <div class="wrap">
    <div class="head head--split day__head">
      <p class="label label--place" data-reveal>{d.label}</p>
      <h2 id="day-title" class="t-headline" data-reveal style="--i:1">{d.headline}</h2>
      <p class="t-lead" data-reveal style="--i:2">{d.lead}</p>
    </div>

    <div class="day__grid">
      <!-- The still photograph, with the sun's arc above it -->
      <div class="day__stage" aria-hidden="true">
        <div class="day__frame">
          {moments.map((m, i) => (
            <div class:list={['day__shot', { 'is-active': i === 0 }]} data-shot={i}>
              {m.image ? (
                <Img src={m.image} alt="" sizes="(min-width: 1024px) 55vw, 100vw" />
              ) : (
                <div class="day__night">
                  {Array.from({ length: 46 }, (_, k) => (
                    <span class="day__star" style={`--x:${(k * 37) % 100}%;--y:${(k * 53) % 78}%;--d:${(k % 7) * 0.4}s;--s:${1 + (k % 3)}px`}></span>
                  ))}
                  {m.e.data.stamp && <Stamp id={m.e.data.stamp as StampId} size={120} decorative />}
                </div>
              )}
            </div>
          ))}
          <p class="day__clock" data-clock>{moments[0].time}</p>
        </div>
        <svg class="day__arc" viewBox="0 0 400 110" preserveAspectRatio="none">
          <path d="M8 104 C 90 -20, 310 -20, 392 104" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 5" />
          <circle r="7" cx="8" cy="104" data-sun></circle>
        </svg>
      </div>

      <ol role="list" class="day__list">
        {moments.map((m, i) => (
          <li class="day__moment" data-moment={i} data-night={i === last ? '' : undefined}>
            <div class="day__card-media frame" aria-hidden="true">
              {m.image ? (
                <Img src={m.image} alt="" sizes="100vw" />
              ) : (
                <div class="day__night">
                  {Array.from({ length: 30 }, (_, k) => (
                    <span class="day__star" style={`--x:${(k * 37) % 100}%;--y:${(k * 53) % 78}%;--d:${(k % 7) * 0.4}s;--s:${1 + (k % 3)}px`}></span>
                  ))}
                  {m.e.data.stamp && <Stamp id={m.e.data.stamp as StampId} size={88} decorative />}
                </div>
              )}
            </div>
            <p class="day__time label">
              <Icon name={i === last ? 'moon-stars' : 'sun-horizon'} />
              {m.time}
            </p>
            <h3 class="t-subhead"><a href={`/experiences/${m.e.id}/`} class="day__name">{m.e.data.name}</a></h3>
            <p class="day__body">{m.body}</p>
            <dl class="day__meta">
              <div><dt class="label">Family</dt><dd>{FAMILY_NAMES[m.e.data.family]} &middot; {direction(m.e.data.family)}</dd></div>
              <div><dt class="label">Led by</dt><dd>{m.e.data.led_by}</dd></div>
            </dl>
            <PickButton slug={m.e.id} name={m.e.data.name} stamp={m.e.data.stamp} size="sm" class="day__pick" />
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { reduceMotion } from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-day]');
  if (root) {
    const shots = Array.from(root.querySelectorAll<HTMLElement>('[data-shot]'));
    const moments = Array.from(root.querySelectorAll<HTMLElement>('[data-moment]'));
    const clock = root.querySelector<HTMLElement>('[data-clock]')!;
    const sun = root.querySelector<SVGCircleElement>('[data-sun]')!;
    const path = root.querySelector<SVGPathElement>('.day__arc path')!;
    let current = -1;

    const show = (i: number) => {
      if (i === current) return;
      current = i;
      shots.forEach((s, k) => s.classList.toggle('is-active', k === i));
      moments.forEach((m, k) => m.classList.toggle('is-active', k === i));
      clock.textContent = moments[i].querySelector('.day__time')?.textContent?.trim() ?? '';
      root.classList.toggle('is-night', moments[i].hasAttribute('data-night'));
    };

    const mm = gsap.matchMedia();
    mm.add('(min-width: 1024px)', () => {
      const triggers = moments.map((m, i) =>
        ScrollTrigger.create({
          trigger: m,
          start: 'top 55%',
          end: 'bottom 55%',
          onToggle: (self) => self.isActive && show(i),
        }),
      );
      // The sun travels its arc across the whole day
      const length = path.getTotalLength();
      const arc = ScrollTrigger.create({
        trigger: root.querySelector('.day__list')!,
        start: 'top 55%',
        end: 'bottom 55%',
        scrub: reduceMotion ? false : 0.4,
        onUpdate: (self) => {
          const p = path.getPointAtLength(length * self.progress);
          sun.setAttribute('cx', String(p.x));
          sun.setAttribute('cy', String(p.y));
        },
      });
      show(0);
      return () => {
        triggers.forEach((t) => t.kill());
        arc.kill();
        root.classList.remove('is-night');
      };
    });
  }
</script>

<style>
  .day {
    --day-bg: var(--natural-white);
    background: var(--day-bg);
    transition:
      background-color 900ms var(--ease),
      color 900ms var(--ease);
  }

  .day__head {
    margin-bottom: var(--s-6);
  }

  .day__grid {
    display: grid;
  }

  .day__stage {
    display: none;
  }

  .day__list {
    display: grid;
    gap: var(--s-6);
  }

  .day__moment {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }

  .day__card-media {
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-bottom: var(--s-2);
  }

  .day__time {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--place);
  }

  .day__time :global(svg) {
    width: 18px;
    height: 18px;
  }

  .day__name {
    text-decoration: none;
  }

  .day__name:hover {
    text-decoration: underline;
    text-decoration-color: var(--warm-ochre);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .day__body {
    max-width: 34rem;
  }

  .day__meta {
    display: grid;
    gap: 6px;
    margin: var(--s-2) 0 0;
    font-family: var(--font-label);
    font-size: var(--text-data);
  }

  .day__meta div {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
  }

  .day__meta dt {
    min-width: 5.5rem;
    color: var(--stone);
    padding-top: 2px;
  }

  .day__meta dd {
    margin: 0;
  }

  /* Night: the panel for the fire, with stars and the Night sky stamp */
  .day__night {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at 50% 120%, var(--panel) 0%, var(--basalt) 60%);
    color: var(--warm-ochre);
    overflow: hidden;
  }

  .day__star {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: var(--natural-white);
    opacity: 0.7;
    animation: twinkle 3.6s var(--ease) var(--d) infinite alternate;
  }

  @keyframes twinkle {
    from { opacity: 0.15; }
    to { opacity: 0.85; }
  }

  @media (min-width: 1024px) {
    .day__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--s-6);
    }

    .day__stage {
      display: grid;
      position: sticky;
      top: calc(var(--nav-h-compact) + 24px);
      height: calc(100svh - var(--nav-h-compact) - 48px);
      grid-template-rows: auto 1fr;
      gap: var(--s-3);
      align-self: start;
    }

    .day__arc {
      order: -1;
      width: 100%;
      height: 56px;
      overflow: visible;
      color: color-mix(in srgb, currentColor 45%, transparent);
    }

    .day__arc circle {
      fill: var(--warm-ochre);
      stroke: var(--natural-white);
      stroke-width: 2;
      transition: fill 900ms var(--ease);
    }

    .day__frame {
      position: relative;
      border-radius: var(--radius);
      overflow: hidden;
      background: var(--basalt);
    }

    .day__shot {
      position: absolute;
      inset: 0;
      opacity: 0;
      clip-path: inset(6% 6% 6% 6% round 6px);
      transform: scale(1.04);
      transition:
        opacity 700ms var(--ease),
        clip-path 1100ms var(--ease-out),
        transform 1600ms var(--ease-out);
    }

    .day__shot.is-active {
      opacity: 1;
      clip-path: inset(0 0 0 0 round 0);
      transform: none;
    }

    .day__shot :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .day__clock {
      position: absolute;
      left: var(--s-4);
      bottom: var(--s-4);
      padding: 8px 14px;
      border-radius: 999px;
      background: rgb(43 43 38 / 0.55);
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
      color: var(--natural-white);
      font-family: var(--font-label);
      font-size: var(--text-label);
      letter-spacing: var(--label-track);
      text-transform: uppercase;
    }

    .day__list {
      gap: 0;
      padding-block: 8vh 30vh;
    }

    .day__moment {
      min-height: 64vh;
      align-content: center;
      opacity: 0.38;
      transition: opacity 600ms var(--ease);
    }

    .day__moment.is-active {
      opacity: 1;
    }

    .day__card-media {
      display: none;
    }

    /* After dark the whole section turns to night */
    .day.is-night {
      --day-bg: var(--basalt);
      color: var(--natural-white);
    }

    .day.is-night .head .t-lead,
    .day.is-night .day__meta dt {
      color: color-mix(in srgb, var(--natural-white) 70%, transparent);
    }

    .day.is-night .day__time,
    .day.is-night .label--place {
      color: var(--warm-ochre);
    }

    .day.is-night :global(.pick__ink) {
      color: var(--warm-ochre);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .day__star {
      animation: none;
    }
  }
</style>
