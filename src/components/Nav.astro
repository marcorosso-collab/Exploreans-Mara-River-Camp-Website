---
/**
 * The compact header (Brand Bible ch. 07, property websites). At the top of every page:
 * the property lockup. Once the guest scrolls past the first screen the header shortens
 * and the place mark crossfades in over 300 ms, replacing the wordmark entirely, so the
 * place travels with them down the page. Scrolling back to the top restores the lockup.
 */
import Lockup from './Lockup.astro';
import Stamp from './Stamp.astro';
import Icon from './Icon.astro';
import MapLines from './MapLines.astro';
import { site as getSite } from '../lib/data';
import { telHref } from '../lib/format';

interface Props {
  theme: 'overlay' | 'solid';
}

const { theme } = Astro.props;
const site = await getSite();
const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== '/' && path.startsWith(href);
---
<header class:list={['nav', `nav--${theme}`]} data-nav>
  <div class="nav__inner wrap">
    <a href="/" class="nav__brand" aria-label={`${site.property_name}, home`}>
      <span class="nav__lockup" aria-hidden="true">
        <Lockup class="nav__lockup-dark" />
        <Lockup class="nav__lockup-light" reversed />
      </span>
      <span class="nav__mark" aria-hidden="true">
        <Stamp id="place-mara-river-camp" size={38} decorative />
      </span>
    </a>

    <nav class="nav__primary" aria-label="Main">
      <ul role="list" class="nav__links">
        {site.nav.map((item) => (
          <li>
            <a class="nav__link label" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <button type="button" class="btn btn--place nav__book" data-book-open>
      <span class="nav__book-long">Book your stay</span>
      <span class="nav__book-short">Book</span>
    </button>

    <button class="nav__menu label" type="button" aria-haspopup="dialog" aria-controls="menu" data-menu-open>
      <span>Menu</span>
      <Icon name="list" class="nav__menu-icon" />
    </button>
  </div>
</header>

<dialog class="menu on-basalt" id="menu" aria-label="Menu" data-menu>
  <MapLines variant="c" tone="light" />
  <div class="menu__inner">
    <div class="menu__top">
      <a href="/" class="menu__brand" aria-label={`${site.property_name}, home`}><Lockup reversed /></a>
      <button class="menu__close label" type="button" data-menu-close>
        <span>Close</span>
        <Icon name="x" class="nav__menu-icon" />
      </button>
    </div>
    <nav aria-label="Main">
      <ul role="list" class="menu__links">
        <li style="--i:0"><a href="/" class="menu__link" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
        {site.nav.map((item, i) => (
          <li style={`--i:${i + 1}`}>
            <a href={item.href} class="menu__link" aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="menu__foot">
      <button type="button" class="btn btn--light" data-book-open>Book your stay <Icon name="arrow-right" class="arrow" /></button>
      <p class="data menu__contact">
        <a class="link" href={`mailto:${site.reservations_email}`}>{site.reservations_email}</a><br />
        <a class="link" href={telHref(site.phone)}>{site.phone}</a>
      </p>
      <p class="menu__master">Explore beyond. Explore within.</p>
    </div>
  </div>
</dialog>

<script>
  import './../scripts/motion';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const root = document.documentElement;

  // Solid from the moment the page moves; compact, with the place mark, after the first screen
  const update = (y: number) => {
    nav.classList.toggle('is-solid', y > 4);
    nav.classList.toggle('is-compact', y > window.innerHeight * 0.85);
  };
  update(window.scrollY);
  ScrollTrigger.create({ start: 0, end: 'max', onUpdate: (self) => update(self.scroll()) });
  window.addEventListener('resize', () => update(window.scrollY));

  // Mobile menu
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = menu.querySelector<HTMLButtonElement>('[data-menu-close]')!;
  const open = () => {
    menu.showModal();
    root.classList.add('menu-open');
    window.__lenis?.stop();
    requestAnimationFrame(() => menu.classList.add('is-open'));
  };
  const close = () => {
    menu.classList.remove('is-open');
    root.classList.remove('menu-open');
    window.__lenis?.start();
    window.setTimeout(() => menu.close(), 320);
  };
  openBtn.addEventListener('click', open);
  closeBtn.addEventListener('click', close);
  menu.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
  menu.querySelectorAll('a, [data-book-open]').forEach((a) => a.addEventListener('click', () => close()));
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    color: var(--basalt);
    transition:
      background-color 450ms var(--ease),
      color 450ms var(--ease),
      box-shadow 450ms var(--ease);
  }

  .nav--overlay {
    color: var(--natural-white);
  }

  .nav--overlay::before {
    content: '';
    position: absolute;
    inset: 0 0 -48px;
    background: linear-gradient(rgb(43 43 38 / 0.5), transparent);
    pointer-events: none;
    transition: opacity 450ms var(--ease);
  }

  .nav--solid,
  .nav.is-solid {
    background: var(--natural-white);
    color: var(--basalt);
    box-shadow: 0 1px 0 var(--hairline);
  }

  .nav.is-solid::before {
    opacity: 0;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    height: 92px;
    transition: height 450ms var(--ease);
  }

  .nav.is-compact .nav__inner {
    height: var(--nav-h-compact);
  }

  /* Brand: the lockup and the place mark share one spot and crossfade */
  .nav__brand {
    position: relative;
    display: grid;
    align-items: center;
    margin-right: auto;
    min-height: 48px;
    color: inherit;
    text-decoration: none;
  }

  .nav__lockup,
  .nav__mark {
    grid-area: 1 / 1;
    transition:
      opacity 300ms var(--ease),
      transform 450ms var(--ease);
  }

  .nav__lockup {
    display: grid;
  }

  .nav__lockup > :global(*) {
    grid-area: 1 / 1;
    transition: opacity 300ms var(--ease);
  }

  /* Over a dark hero the lockup is reversed; on Natural White it is Basalt and Safari Green */
  .nav__lockup :global(.nav__lockup-dark) {
    opacity: 0;
  }

  .nav--solid .nav__lockup :global(.nav__lockup-dark),
  .nav.is-solid .nav__lockup :global(.nav__lockup-dark) {
    opacity: 1;
  }

  .nav--solid .nav__lockup :global(.nav__lockup-light),
  .nav.is-solid .nav__lockup :global(.nav__lockup-light) {
    opacity: 0;
  }

  .nav__mark {
    display: grid;
    place-items: center;
    justify-self: start;
    opacity: 0;
    transform: scale(0.86);
    color: var(--place);
    pointer-events: none;
  }

  .nav--overlay:not(.is-solid) .nav__mark {
    color: var(--natural-white);
  }

  .nav.is-compact .nav__lockup {
    opacity: 0;
    transform: scale(0.94);
    pointer-events: none;
  }

  .nav.is-compact .nav__mark {
    opacity: 1;
    transform: none;
  }

  .nav__primary {
    display: none;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  .nav__link {
    position: relative;
    display: inline-block;
    padding: 12px 0;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms var(--ease);
  }

  .nav__link:hover::after,
  .nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav__book {
    min-height: 44px;
    padding: 0 18px;
  }

  .nav--overlay:not(.is-solid) .nav__book {
    --btn-bg: var(--natural-white);
    --btn-fg: var(--basalt);
    --btn-border: var(--natural-white);
  }

  .nav__book-long {
    display: none;
  }

  .nav__menu {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 0 0 4px;
    background: none;
    border: 0;
  }

  .nav__menu span {
    display: none;
  }

  :global(.nav__menu-icon) {
    width: 26px;
    height: 26px;
  }

  @media (min-width: 560px) {
    .nav__menu span {
      display: inline;
    }

    .nav__book-long {
      display: inline;
    }

    .nav__book-short {
      display: none;
    }
  }

  @media (min-width: 1140px) {
    .nav__primary {
      display: block;
    }

    .nav__menu {
      display: none;
    }
  }

  @media (min-width: 1140px) and (max-width: 1279px) {
    .nav__links {
      gap: var(--s-4);
    }
  }

  @media (max-width: 559px) {
    .nav__inner {
      height: 80px;
      gap: var(--s-3);
    }

    .nav__brand :global(.lockup) {
      --w: 140px;
    }
  }

  /* ---------- Menu ---------- */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden auto;
    opacity: 0;
    transition: opacity 320ms var(--ease);
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu.is-open {
    opacity: 1;
  }

  .menu__inner {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--s-5);
    min-height: 100%;
    padding: 20px var(--margin) var(--s-5);
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
  }

  .menu__brand {
    color: inherit;
  }

  .menu__brand :global(.lockup) {
    --w: 140px;
  }

  .menu__close {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    background: none;
    border: 0;
  }

  .menu__links {
    display: grid;
    align-content: center;
    gap: 6px;
  }

  .menu__link {
    display: inline-block;
    padding: 6px 0;
    font-size: clamp(2rem, 1.4rem + 3vw, 3rem);
    line-height: 1.15;
    text-decoration: none;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 600ms var(--ease-out),
      transform 600ms var(--ease-out);
    transition-delay: calc(80ms + var(--i) * 60ms);
  }

  .menu.is-open .menu__link {
    opacity: 1;
    transform: none;
  }

  .menu__link[aria-current='page'] {
    color: var(--warm-ochre);
  }

  .menu__foot {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }

  .menu__contact {
    color: color-mix(in srgb, var(--natural-white) 80%, transparent);
  }

  .menu__master {
    font-style: italic;
    color: var(--warm-ochre);
  }
</style>
