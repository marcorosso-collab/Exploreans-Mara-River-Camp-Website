---
/**
 * An experience, described the same way everywhere (Brand Bible ch. 02): family and place,
 * name, who leads it, when and how long, what you will live, good to know, and the stamp.
 */
import Img from './Img.astro';
import Stamp from './Stamp.astro';
import MapLines from './MapLines.astro';
import PickButton from './PickButton.astro';
import { FAMILY_NAMES, type StampId } from '../lib/stamps';
import type { Experience } from '../lib/data';

interface Props {
  experience: Experience;
  /** 'full' shows every field; 'compact' is for rails */
  variant?: 'full' | 'compact';
  sizes?: string;
}

const { experience, variant = 'full', sizes = '(min-width: 1200px) 33vw, (min-width: 768px) 50vw, 90vw' } = Astro.props;
const e = experience.data;
const href = `/experiences/${experience.id}/`;
---
<article class:list={['xp', `xp--${variant}`]} data-family={e.family} data-reveal>
  <a href={href} class="xp__media" data-follow="Read" tabindex="-1" aria-hidden="true">
    {e.image ? (
      <Img src={e.image} alt="" sizes={sizes} />
    ) : (
      <span class="xp__night on-basalt">
        <MapLines variant="c" tone="light" />
        {e.stamp && <Stamp id={e.stamp as StampId} size={96} decorative />}
      </span>
    )}
  </a>
  <div class="xp__body">
    <div class="xp__top">
      <p class="label label--place">{FAMILY_NAMES[e.family]} &middot; Mara River Camp</p>
      {e.stamp && <Stamp id={e.stamp as StampId} size={40} class="xp__stamp" label={`${FAMILY_NAMES[e.family]} stamp`} />}
    </div>
    <h3 class="t-subhead xp__name"><a href={href}>{e.name}</a></h3>
    <dl class="xp__fields">
      <div><dt class="label muted">Led by</dt><dd>{e.led_by}</dd></div>
      {variant === 'full' && <div><dt class="label muted">When and how long</dt><dd>{e.when}</dd></div>}
      {variant === 'full' && <div><dt class="label muted">What you will live</dt><dd class="xp__live">{e.live}</dd></div>}
      {variant === 'full' && <div><dt class="label muted">Good to know</dt><dd>{e.good_to_know}</dd></div>}
    </dl>
    <div class="xp__foot">
      <PickButton slug={experience.id} name={e.name} stamp={e.stamp} size="sm" />
      <a href={href} class="xp__more label">Read more<span class="visually-hidden"> about {e.name}</span></a>
    </div>
  </div>
</article>

<style>
  .xp {
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--linen);
    border-radius: var(--radius);
    overflow: hidden;
    height: 100%;
  }

  .xp__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--hairline);
  }

  .xp__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1200ms var(--ease-out);
  }

  .xp:hover .xp__media :global(img) {
    transform: scale(1.04);
  }

  .xp__night {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--warm-ochre);
  }

  .xp__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-4);
  }

  .xp__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-3);
  }

  .xp__top :global(.xp__stamp) {
    color: var(--place);
    margin-top: -6px;
  }

  .xp__name a {
    text-decoration: none;
  }

  .xp__name a:hover {
    text-decoration: underline;
    text-decoration-color: var(--warm-ochre);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .xp__fields {
    display: grid;
    gap: var(--s-3);
    margin: 0;
  }

  .xp__fields dt {
    font-size: 0.75rem;
    margin-bottom: 2px;
  }

  .xp__fields dd {
    margin: 0;
  }

  .xp__live {
    font-style: italic;
  }

  .xp__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    margin-top: auto;
    padding-top: var(--s-3);
    border-top: 1px solid color-mix(in srgb, var(--basalt) 14%, transparent);
  }

  .xp__more {
    padding: 12px 0;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    line-height: 1;
  }

  .xp--compact .xp__media {
    aspect-ratio: 4 / 5;
  }
</style>
