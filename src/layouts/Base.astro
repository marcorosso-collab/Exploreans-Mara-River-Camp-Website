---
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  navDark?: boolean;
}

const settings = await getEntry('settings', 'global');
const site = settings.data;

const {
  title = `${site.propertyName} | ${site.siteName} — Luxury Safari Camp, Maasai Mara, Kenya`,
  description = 'Exploreans Mara River Camp — A luxury tented camp on the banks of the Mara River in Kenya\'s Maasai Mara. Witness the Great Migration, enjoy authentic safari experiences, and stay where wildlife comes to you. Book your stay today.',
  ogImage,
  canonicalUrl = Astro.url.pathname,
  navDark = false,
  schemaType = 'LodgingBusiness',
} = Astro.props;

const siteUrl = 'https://mara.exploreans.com';
const fullCanonicalUrl = `${siteUrl}${canonicalUrl}`;
const fullOgImage = ogImage ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`) : null;
---
<!DOCTYPE html>
<html lang="en">
<head>
<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-PZCKDW9Z');</script>
<!-- End Google Tag Manager -->

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Favicon for browser tabs -->
  {site.favicon && <link rel="icon" type="image/png" href={site.favicon} />}
  
  <!-- Shortcut icon (for older browsers and some search engines) -->
  {site.favicon && <link rel="shortcut icon" type="image/png" href={site.favicon} />}
  
  <!-- Apple Touch Icon (used by Google for search results and mobile) -->
  {site.favicon && <link rel="apple-touch-icon" sizes="180x180" href={site.favicon} />}
  
  <!-- Additional icon sizes for better compatibility -->
  {site.favicon && <link rel="icon" type="image/png" sizes="32x32" href={site.favicon} />}
  {site.favicon && <link rel="icon" type="image/png" sizes="16x16" href={site.favicon} />}
  <title>{title}</title>
  <meta name="description" content={description}>
  
  <!-- Canonical URL -->
  <link rel="canonical" href={fullCanonicalUrl} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={fullCanonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {fullOgImage && <meta property="og:image" content={fullOgImage} />}
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={fullCanonicalUrl} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  {fullOgImage && <meta property="twitter:image" content={fullOgImage} />}
  
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-QV5BLB9NV3"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-QV5BLB9NV3');
  </script>
  
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Hotel",
    "name": "Exploreans Mara River Camp",
    "description": description,
    "url": fullCanonicalUrl,
    "image": fullOgImage || `${siteUrl}/images/og-default.jpg`,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Maasai Mara",
      "addressRegion": "Narok County",
      "addressCountry": "KE"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": -1.5065,
      "longitude": 35.1430
    },
    "telephone": "+254 20 234 5678",
    "email": "reservations.exploreansmara@planhotel.com",
    "priceRange": "$$$$",
    "starRating": {
      "@type": "Rating",
      "ratingValue": "5"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.5",
      "reviewCount": "235",
      "bestRating": "5"
    },
    "amenityFeature": [
      {
        "@type": "LocationFeatureSpecification",
        "name": "Riverfront location",
        "value": true
      },
      {
        "@type": "LocationFeatureSpecification",
        "name": "Great Migration viewing",
        "value": true
      },
      {
        "@type": "LocationFeatureSpecification",
        "name": "Game drives",
        "value": true
      },
      {
        "@type": "LocationFeatureSpecification",
        "name": "Bush dining",
        "value": true
      },
      {
        "@type": "LocationFeatureSpecification",
        "name": "Swimming pool",
        "value": true
      }
    ],
    "hasMap": "https://www.google.com/maps/search/?api=1&query=Exploreans+Mara+River+Camp",
    "sameAs": [
      "https://www.facebook.com/ExploreansMaraRiverCamp/",
      "https://www.tripadvisor.com/Hotel_Review-g28467248-d4071947-Reviews-Exploreans_Mara_River_Camp-Oloololo_Rift_Valley_Province.html"
    ]
  })} />
  
  <!-- Breadcrumb Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://mara.exploreans.com/"
      }
    ]
  })} />
  
  <link rel="stylesheet" href="/styles/global.css">
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PZCKDW9Z"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

  <!-- Navigation -->
  <nav class={`nav ${navDark ? 'nav-dark' : ''}`} id="mainNav">
    <a href="/" class="nav-brand">
      {site.logo ? (
        <img src={site.logo} alt={site.siteName} class="nav-logo-img" />
      ) : (
        site.siteName
      )}
    </a>
    <ul class="nav-links" id="navLinks">
      <li><a href="#camp">The Camp</a></li>
      <li><a href="#stay">Stay</a></li>
      <li><a href="#when-to-visit">When to Visit</a></li>
      <li><a href="#experiences">Experiences</a></li>
      <li><a href="#journal">Journal</a></li>
      <li><a href="/contact">Contact Us</a></li>
    </ul>
    <div class="nav-actions">
      <a href={site.bookingUrl} class="nav-cta" target="_blank" rel="noopener">Book Now</a>
        <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <slot />

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-grid">
      <div>
        <div class="footer-logo">{site.siteName}</div>
        <div class="footer-subtitle">{site.propertyName} · Kenya</div>
      </div>
      <div class="footer-links">
        <div class="footer-col">
          <h4>The Camp</h4>
          <a href="#camp">Our Story</a>
          <a href="#camp">Location</a>
        </div>
        <div class="footer-col">
          <h4>Stay</h4>
          <a href="#stay">River Tents</a>
          <a href="#stay">Bush Tents</a>
          <a href="#stay">Simba's Den</a>
        </div>
        <div class="footer-col">
          <h4>Explore</h4>
          <a href="#when-to-visit">When to Visit</a>
          <a href="#experiences">Game Drives</a>
          <a href="#journal">Journal</a>
        </div>
      </div>
      <div class="footer-managed">
        <div class="footer-managed-label">Managed by</div>
        <div class="footer-managed-name">Planhotel<br>Hospitality Group</div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2026 {site.siteName} · Planhotel Hospitality Group</span>
      <div class="lang-switcher">
        <a href="#"><strong>EN</strong></a>
        <a href="#">DE</a>
        <a href="#">IT</a>
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const nav = document.getElementById('mainNav');
      const navToggle = document.getElementById('navToggle');
      const navLinks = document.getElementById('navLinks');
      
      if (!navToggle || !navLinks) {
        console.error('Mobile menu elements not found');
        return;
      }
      
      console.log('Mobile menu initialized');
      
      window.addEventListener('scroll', () => {
        nav?.classList.toggle('scrolled', window.scrollY > 80);
      });
      
      navToggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        this.classList.toggle('active');
        navLinks.classList.toggle('active');
        console.log('Menu toggled:', navLinks.classList.contains('active'));
      });
      
      // Close menu when clicking a link
      navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          navToggle.classList.remove('active');
          navLinks.classList.remove('active');
        });
      });
      
      // Close menu when clicking outside
      document.addEventListener('click', (e) => {
        if (!nav.contains(e.target) && navLinks.classList.contains('active')) {
          navToggle.classList.remove('active');
          navLinks.classList.remove('active');
        }
      });
    });
  </script>
</body>
</html>
