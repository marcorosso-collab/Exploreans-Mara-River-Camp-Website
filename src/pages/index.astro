---
/**
 * Home, in the order the brand bible sets for every place page: the place at its best
 * moment, what you will live, experiences with who leads them, the people, rooms and
 * spaces, what to expect, the Passport, and plan your journey.
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Story from '../components/home/Story.astro';
import Day from '../components/home/Day.astro';
import Families from '../components/home/Families.astro';
import People from '../components/home/People.astro';
import Stay from '../components/home/Stay.astro';
import Expect from '../components/home/Expect.astro';
import Passport from '../components/home/Passport.astro';
import Plan from '../components/home/Plan.astro';
import { site as getSite } from '../lib/data';

const home = (await getEntry('home', 'home'))!.data;
const site = await getSite();
---
<Base title={home.seo_title ?? site.property_name} description={home.seo_description ?? site.default_description}>
  <link slot="head" rel="preload" as="image" href={home.hero.poster} fetchpriority="high" />
  <Hero />
  <Story />
  <Day />
  <Families />
  <People />
  <Stay />
  <Expect />
  <Passport />
  <Plan />
</Base>
