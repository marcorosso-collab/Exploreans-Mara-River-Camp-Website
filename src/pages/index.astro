---
import Base from '../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import '../styles/global.css';

// Load CMS content
const page = await getEntry('homepage', 'sections');
const { hero, intro, riverUsp, migration, dining, planVisit, stay, experiencesSection, journalSection } = page.data;

const allAccommodation = await getCollection('accommodation');
const rooms = allAccommodation.sort((a, b) => a.data.order - b.data.order);

const allExperiences = await getCollection('experiences');
const exps = allExperiences.sort((a, b) => a.data.order - b.data.order);

const allJournal = await getCollection('journal', ({ data }) => !data.draft);
const posts = allJournal.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// Default OG image for homepage
const defaultOgImage = hero.image || '/images/og-default.jpg';
---

<Base ogImage={defaultOgImage}>

  <!-- ═══ HERO ═══ -->
  <section class="hero" aria-label="Hero">
    <div class="hero-bg">
      {hero.video ? (
        <video autoplay muted loop playsinline poster={hero.image || undefined}>
          <source src={hero.video} type="video/mp4" />
          {hero.image && <img src={hero.image} alt={hero.imageAlt || ''} />}
        </video>
      ) : hero.image ? (
        <img src={hero.image} alt={hero.imageAlt || ''} loading="eager" fetchpriority="high" />
      ) : (
        <div class="img-placeholder" style="height:100%;aspect-ratio:auto;">Hero image — upload via CMS</div>
      )}
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-tagline">{hero.tagline}</p>
      <h1>Where the river bends,<br />the wild begins</h1>
      <p class="hero-subhead">Exploreans Mara River Camp — Authentic Safari, Maasai Mara</p>
      <div class="hero-ctas">
        <a href={planVisit.ctaUrl} class="btn-ochre" target="_blank" rel="noopener">Book Your Safari</a>
        <a href="#camp" class="btn-outline">Discover the Camp</a>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true">
      <span>Scroll</span>
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 5v14M5 12l7 7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </section>


  <!-- ═══ THE CAMP — merged intro + river USP into one powerful narrative ═══ -->
  <section class="section" id="camp">
    <div class="container">
      <div class="grid-2col reveal">
        <div>
          <p class="section-label">{intro.label}</p>
          <h2 set:html={intro.headline} />
          <p class="lead-text">{intro.leadText}</p>
          <p class="body-text">{intro.bodyText}</p>
        </div>
        {intro.image
          ? <img src={intro.image} alt={intro.imageAlt || ''} style="aspect-ratio:4/5;object-fit:cover;border-radius:2px;" loading="lazy" />
          : <div class="img-placeholder ratio-4-5">Camp overview — upload via CMS</div>
        }
      </div>
    </div>
  </section>


  <!-- ═══ RIVER USP — what makes us different, with stats ═══ -->
  <section class="section-dark">
    <div class="container">
      <div class="reveal">
        <p class="section-label">{riverUsp.label}</p>
        <h2 style="max-width:700px;" set:html={riverUsp.headline} />
        <p class="body-text" style="max-width:600px;">{riverUsp.bodyText}</p>
      </div>

      {riverUsp.image
        ? <img src={riverUsp.image} alt={riverUsp.imageAlt || ''} style="display:block;width:100%;margin:56px auto;height:520px;object-fit:cover;border-radius:2px;" loading="lazy" />
        : <div class="img-placeholder wide" style="margin:56px auto;width:100%;">Panoramic — upload via CMS</div>
      }

      <div class="stat-grid reveal-stagger">
        {riverUsp.stats.map((stat) => (
          <div>
            <div class="stat-number">{stat.number}</div>
            <div class="stat-label" set:html={stat.label} />
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══ TRUST BAR — why guests choose us ═══ -->
  <section class="section-white" style="padding:64px 0;">
    <div class="container">
      <div class="trust-bar reveal-stagger">
        <div class="trust-item">
          <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/>
            <circle cx="12" cy="12" r="10"/>
          </svg>
          <div class="trust-title">On the Mara River</div>
          <div class="trust-desc">Wildlife comes to you — no drives required to see hippos, elephants & giraffes</div>
        </div>
        <div class="trust-item">
          <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707"/>
            <circle cx="12" cy="12" r="4"/>
          </svg>
          <div class="trust-title">Great Migration Gateway</div>
          <div class="trust-desc">Minutes from major river crossing points during July–October</div>
        </div>
        <div class="trust-item">
          <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <div class="trust-title">Intimate by Design</div>
          <div class="trust-desc">Only 23 tents & 1 cabin — personal service, uncrowded game drives</div>
        </div>
        <div class="trust-item">
          <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
          </svg>
          <div class="trust-title">Authentic Experiences</div>
          <div class="trust-desc">Maasai village visits, bush dining, walking safaris & balloon rides</div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══ ACCOMMODATION ═══ -->
  <section class="section" id="stay">
    <div class="container">
      <div class="reveal" style="text-align:center;max-width:640px;margin:0 auto 72px;">
        <p class="section-label center">{stay.label}</p>
        <h2 set:html={stay.headline} />
        <p class="body-text">{stay.subtitle}</p>
      </div>

      <div class="grid-3col reveal-stagger">
        {rooms.map((room) => (
          <div class="accom-card img-zoom">
            {room.data.image
              ? <img src={room.data.image} alt={room.data.imageAlt || ''} style="aspect-ratio:3/2;object-fit:cover;" loading="lazy" />
              : <div class="img-placeholder ratio-3-2">{room.data.title} — upload via CMS</div>
            }
            <div class="card-body">
              <div class="card-category">{room.data.category}</div>
              <h3>{room.data.title}</h3>
              <p class="body-text">{room.data.description}</p>
              <div class="card-meta">
                <span>{room.data.sqm}</span>
                <span>Up to {room.data.maxGuests} guests</span>
              </div>
              <a href={`/accommodation/${room.slug}`} class="btn-more-info" style="display:inline-block;margin-top:20px;font-family:var(--font-functional);font-size:11px;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;color:var(--deep-moss);border-bottom:1px solid var(--sand);padding-bottom:2px;transition:border-color 0.3s;">More info →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══ EXPERIENCES — elevated, immersive ═══ -->
  <section class="section-parchment" id="experiences">
    <div class="container">
      <div class="reveal" style="margin-bottom:72px;text-align:center;max-width:600px;margin-left:auto;margin-right:auto;">
        <p class="section-label center">{experiencesSection.label}</p>
        <h2 set:html={experiencesSection.headline} />
        <p class="body-text" style="margin-top:16px;">Every day at Mara River Camp is shaped by the land around you. These are the moments that stay with you long after you leave.</p>
      </div>

      <div class="grid-3col reveal-stagger">
        {exps.map((exp) => (
          <a href={`/experiences/${exp.slug}`} class="exp-card experience-card-link">
            {exp.data.image
              ? <img src={exp.data.image} alt={exp.data.imageAlt || ''} style="aspect-ratio:16/10;object-fit:cover;" loading="lazy" />
              : <div class="img-placeholder ratio-16-10">{exp.data.title} — upload via CMS</div>
            }
            <div class="card-overlay">
              <div class="exp-label">{exp.data.label}</div>
              <h3>{exp.data.title}</h3>
              <span class="read-more">More info →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══ WHEN TO VISIT — migration calendar, more visual ═══ -->
  <section class="section" id="when-to-visit" style="overflow:hidden;">
    <div class="container">
      <div class="grid-2col reveal" style="align-items:start;">
        <div style="padding-bottom:48px;">
          <p class="section-label">{migration.label}</p>
          <h2 set:html={migration.headline} />
          <p class="lead-text">{migration.leadText}</p>
          <p class="body-text">{migration.bodyText}</p>

          <div class="month-grid" style="margin-top:48px;">
            {months.map((m) => (
              <div class={`month-pill${migration.activeMonths.includes(m) ? ' active' : ''}`}>{m}</div>
            ))}
          </div>

          <p class="body-text" style="font-size:13px;color:var(--river-grey);margin-top:24px;">{migration.disclaimer}</p>
        </div>

        {migration.image
          ? <img src={migration.image} alt={migration.imageAlt || ''} style="min-height:600px;object-fit:cover;border-radius:2px;" loading="lazy" />
          : <div class="img-placeholder tall" style="min-height:600px;">Migration crossing — upload via CMS</div>
        }
      </div>
    </div>
  </section>


  <!-- ═══ DINING — streamlined, integrated ═══ -->
  <section class="section-white">
    <div class="container">
      <div class="grid-2col grid-2col-reverse reveal">
        <div>
          <p class="section-label">{dining.label}</p>
          <h2 set:html={dining.headline} />
          <p class="body-text">{dining.bodyText}</p>
          <p class="body-text" style="color:var(--river-grey);">{dining.secondaryText}</p>

          <div class="dining-list">
            {dining.bushExperiences.map((item) => (
              <div class="dining-item"><span class="dot"></span> {item}</div>
            ))}
          </div>
        </div>
        {dining.image
          ? <img src={dining.image} alt={dining.imageAlt || ''} style="min-height:500px;object-fit:cover;border-radius:2px;" loading="lazy" />
          : <div class="img-placeholder tall">Dining — upload via CMS</div>
        }
      </div>
    </div>
  </section>


  <!-- ═══ TESTIMONIALS — social proof, new section ═══ -->
  <section class="section-ochre">
    <div class="container">
      <div class="reveal" style="text-align:center;max-width:600px;margin:0 auto 56px;">
        <p class="section-label center ochre">Guest Stories</p>
        <h2>What travellers say about Mara River Camp</h2>
      </div>
      <div class="grid-3col reveal-stagger">
        <div class="testimonial-card">
          <p class="testimonial-text">The most authentic safari experience we have ever had. Elephants walked past our tent at sunset. Hippos grunted us to sleep. This is the Masai Mara as it should be.</p>
          <div class="testimonial-author">Sarah & James M.</div>
          <div class="testimonial-source">United Kingdom · Great Migration Season</div>
        </div>
        <div class="testimonial-card">
          <p class="testimonial-text">We have stayed at many camps in the Mara, but none sit directly on the river like this. Watching crocodiles and wildebeest from your private veranda is unforgettable.</p>
          <div class="testimonial-author">Hans Weber</div>
          <div class="testimonial-source">Switzerland · Repeat Guest</div>
        </div>
        <div class="testimonial-card">
          <p class="testimonial-text">Intimate, unpretentious, and perfectly located. The guides know every inch of this land. Our children still talk about the Maasai village visit two years later.</p>
          <div class="testimonial-author">The Rossi Family</div>
          <div class="testimonial-source">Italy · Family Safari</div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══ JOURNAL ═══ -->
  <section class="section-parchment" id="journal">
    <div class="container">
      <div class="reveal" style="margin-bottom:56px;text-align:center;max-width:500px;margin-left:auto;margin-right:auto;">
        <p class="section-label center">{journalSection.label}</p>
        <h2>{journalSection.headline}</h2>
        <p class="body-text" style="margin-top:12px;">Field notes, seasonal guides, and stories from the Maasai Mara.</p>
      </div>

      <div class="grid-3col reveal-stagger">
        {posts.map((post) => (
          <a href={`/journal/${post.slug}`} class="accom-card journal-card img-zoom">
            {post.data.image
              ? <img src={post.data.image} alt={post.data.imageAlt || ''} style="aspect-ratio:16/10;object-fit:cover;" loading="lazy" />
              : <div class="img-placeholder ratio-16-10">{post.data.title}</div>
            }
            <div class="card-body">
              <div class="card-category">{post.data.category}</div>
              <h3>{post.data.title}</h3>
              <p class="body-text">{post.data.description}</p>
              <span class="read-more" style="display:inline-block;margin-top:16px;font-family:var(--font-functional);font-size:11px;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;color:var(--deep-moss);">Read more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══ PLAN YOUR VISIT — strong CTA ═══ -->
  <section class="section-green" id="plan">
    <div class="container">
      <div class="reveal">
        <p class="section-label center">{planVisit.label}</p>
        <h2>{planVisit.headline}</h2>
        <p class="lead-text" style="max-width:560px;margin:16px auto 40px;">{planVisit.bodyText}</p>
        <a href={planVisit.ctaUrl} class="btn-ochre" target="_blank" rel="noopener" style="font-size:13px;padding:18px 48px;">{planVisit.ctaText}</a>
      </div>

      <div class="plan-info reveal-stagger" style="margin-top:72px;">
        {planVisit.infoItems.map((item) => (
          <div class="plan-info-item">
            <div class="plan-info-label">{item.label}</div>
            <div class="plan-info-value">{item.value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FAQ SCHEMA (already in Base.astro via JSON-LD, but keeping inline for backward compat) ═══ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Where is Exploreans Mara River Camp located?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Exploreans Mara River Camp is located on a graceful bend of the Mara River at the foot of the Oloololo Escarpment in Kenya's Maasai Mara National Reserve. The camp is just 15 minutes from Kichwa Tembo Airstrip."
        }
      },
      {
        "@type": "Question",
        "name": "When is the best time to visit Mara River Camp for the Great Migration?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The best time to witness the Great Migration is from July to October, when millions of wildebeest and zebra cross the Mara River. The camp's location directly on the river puts you at the heart of this spectacle."
        }
      },
      {
        "@type": "Question",
        "name": "What makes Exploreans Mara River Camp different from other safari camps?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Unlike camps that require drives to find wildlife, Mara River Camp sits directly on the Mara River. Elephants, hippos, giraffes, and crocodiles are daily visitors to the grounds. With only 23 tents and one cabin, it is intimate by design."
        }
      },
      {
        "@type": "Question",
        "name": "What types of accommodation are available at Mara River Camp?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The camp offers River Tents with direct river views, Bush Tents nestled in the wilderness, and Simba's Den — a private two-bedroom family cabin. All accommodations feature en-suite bathrooms and private verandas."
        }
      },
      {
        "@type": "Question",
        "name": "What safari experiences are offered at Mara River Camp?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Guests enjoy game drives, guided walking safaris, hot air balloon rides, Maasai cultural visits, bush dining, and sundowner cocktails. Wildlife often visits the camp grounds itself."
        }
      },
      {
        "@type": "Question",
        "name": "How do I get to Exploreans Mara River Camp from Nairobi?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The camp is approximately 15 minutes from Kichwa Tembo Airstrip, which has regular flights from Nairobi Wilson Airport (approx. 45 minutes). Road transfers from Nairobi take approximately 5-6 hours."
        }
      }
    ]
  })} />

</Base>
