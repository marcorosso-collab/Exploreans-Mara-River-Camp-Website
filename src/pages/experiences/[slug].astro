---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import PickButton from '../../components/PickButton.astro';
import Stamp from '../../components/Stamp.astro';
import Icon from '../../components/Icon.astro';
import { experiences, direction } from '../../lib/data';
import { FAMILY_NAMES, stampLabel, type StampId } from '../../lib/stamps';

export async function getStaticPaths() {
  const list = await experiences();
  return list.map((experience) => ({
    params: { slug: experience.id },
    props: {
      experience,
      more: [
        ...list.filter((e) => e.id !== experience.id && e.data.family === experience.data.family),
        ...list.filter((e) => e.id !== experience.id && e.data.family !== experience.data.family),
      ].slice(0, 3),
    },
  }));
}

const { experience, more } = Astro.props;
const e = experience.data;
const { Content } = await render(experience);
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const jsonLd = [
  {
    '@type': 'TouristAttraction',
    name: e.name,
    description: e.live,
    ...(e.image ? { image: `${siteUrl}${e.image}` } : {}),
    isAccessibleForFree: e.included,
    containedInPlace: { '@id': `${siteUrl}/#lodging` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Experiences', item: `${siteUrl}/experiences/` },
      { '@type': 'ListItem', position: 3, name: e.name, item: `${siteUrl}/experiences/${experience.id}/` },
    ],
  },
];
---
<Base
  title={e.seo_title ?? `${e.name} | Mara River Camp`}
  description={e.seo_description ?? e.live}
  ogImage={e.image}
  navTheme={e.image ? 'overlay' : 'solid'}
  jsonLd={jsonLd}
>
  <PageHeader
    label={`${FAMILY_NAMES[e.family]} · ${direction(e.family)}`}
    title={e.name}
    lead={e.live}
    image={e.image}
    alt={e.alt}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Experiences', href: '/experiences/' }, { label: e.name }]}
  />

  <section class="section">
    <div class="wrap xd">
      <div class="prose xd__story" data-reveal>
        <Content />
      </div>
      <aside class="xd__card on-linen" aria-label="The experience at a glance">
        <div class="xd__top">
          <p class="label label--place">{FAMILY_NAMES[e.family]} &middot; Mara River Camp</p>
          {e.stamp && <Stamp id={e.stamp as StampId} size={56} class="xd__stamp" label={`${stampLabel(e.stamp as StampId)} stamp`} />}
        </div>
        <p class="t-subhead">{e.name}</p>
        <dl class="xd__fields">
          <div><dt class="label muted">Led by</dt><dd>{e.led_by}</dd></div>
          <div><dt class="label muted">When and how long</dt><dd>{e.when}</dd></div>
          {e.where && <div><dt class="label muted">Where</dt><dd>{e.where}</dd></div>}
          <div><dt class="label muted">What you will live</dt><dd class="xd__live">{e.live}</dd></div>
          <div><dt class="label muted">Good to know</dt><dd>{e.good_to_know}</dd></div>
          {e.stamp && <div><dt class="label muted">Stamp</dt><dd>{stampLabel(e.stamp as StampId)}, in your Exploreans Passport</dd></div>}
        </dl>
        <div class="xd__rates">
          {e.included ? (
            <p class="xd__free"><span class="label">With every stay</span> Included with every stay at the camp, at no extra charge.</p>
          ) : (
            <>
              <p class="label muted">{e.rates.length > 1 ? 'Rates' : 'Rate'}</p>
              <dl class="xd__lines">
                {e.rates.map((r) => <div><dt>{r.label}</dt><dd class="data">{r.value}</dd></div>)}
              </dl>
              {e.fees.length > 0 && (
                <>
                  <p class="label muted xd__also">Also payable</p>
                  <dl class="xd__lines">
                    {e.fees.map((f) => <div><dt>{f.label}</dt><dd class="data">{f.value}</dd></div>)}
                  </dl>
                </>
              )}
              <p class="xd__note data">Rates are in US dollars and subject to change. The reservations team confirms the current rate when you book.</p>
            </>
          )}
        </div>
        <PickButton slug={experience.id} name={e.name} stamp={e.stamp} />
        <div class="xd__actions">
          <a href={`/plan-your-stay/?experience=${experience.id}#enquire`} class="btn btn--place">Plan it into your stay <Icon name="arrow-right" class="arrow" /></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="more-title">
    <div class="wrap">
      <div class="more__head">
        <h2 id="more-title" class="t-headline">More from the camp</h2>
        <a class="link-arrow" href="/experiences/">Every experience <Icon name="arrow-right" /></a>
      </div>
      <div class="more">
        {more.map((m) => <ExperienceCard experience={m} variant="compact" />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .xd {
    display: grid;
    gap: var(--s-6);
  }

  .xd__card {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding: var(--s-4);
    border-radius: var(--radius);
  }

  .xd__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-3);
  }

  .xd__top :global(.xd__stamp) {
    color: var(--place);
  }

  .xd__fields {
    display: grid;
    gap: var(--s-3);
    margin: 0 0 var(--s-2);
  }

  .xd__fields dt {
    font-size: 0.75rem;
    margin-bottom: 2px;
  }

  .xd__fields dd {
    margin: 0;
  }

  .xd__live {
    font-style: italic;
  }

  .xd__rates {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-3);
    border-top: 1px solid color-mix(in srgb, var(--basalt) 14%, transparent);
  }

  .xd__lines {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .xd__lines div {
    display: grid;
    gap: 2px;
  }

  .xd__lines dt {
    font-size: 0.9375rem;
  }

  .xd__lines dd {
    margin: 0;
  }

  .xd__also {
    margin-top: var(--s-2);
  }

  .xd__note {
    margin-top: var(--s-2);
    font-size: 0.8125rem;
    color: var(--stone);
  }

  .xd__free {
    display: grid;
    gap: 6px;
  }

  .xd__free .label {
    justify-self: start;
    padding: 6px 10px;
    border-radius: 3px;
    background: var(--place);
    color: var(--natural-white);
    font-size: 0.75rem;
  }

  .xd__actions {
    padding-top: var(--s-3);
    border-top: 1px solid color-mix(in srgb, var(--basalt) 14%, transparent);
  }

  .more__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--gutter);
  }

  @media (min-width: 1024px) {
    .xd {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: var(--s-6);
      align-items: start;
    }

    .xd__card {
      position: sticky;
      top: calc(var(--nav-h-compact) + 24px);
      padding: var(--s-5);
    }
  }
</style>
