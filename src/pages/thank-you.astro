---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Thank you | Mara River Camp" description="Your message is on its way to the team at Mara River Camp." navTheme="solid" noindex>
  <PageHeader label="Thank you" title="Your message is on its way" lead="The team at the camp will reply within a day, often sooner.">
    <a class="btn btn--outline" href="/" data-reveal style="--i:4">Back to the camp <Icon name="arrow-right" class="arrow" /></a>
  </PageHeader>
  <div class="section--tight"></div>
</Base>
